<% layout("/layouts/boilerplate") %><%= success %>
<body>
<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.2rem;
        padding: 1rem 0;
    }

    .filter {
        text-align: center;
        min-width: 60px;
        opacity: 0.7;
        cursor: pointer;
        flex-shrink: 0;
    }

    .filter:hover {
        opacity: 1;
    }

    .filter i {
        font-size: 1.3rem;
    }

    .filter p {
        font-size: 0.8rem;
        margin: 0.4rem 0;
        white-space: nowrap;
    }

    .tax-toggle {
        margin-left: auto;
        padding: 0.8rem;
        border: 1px solid #ccc;
        border-radius: 1rem;
    }
    .tax-info {
        display : none;
       } 

    /* Tablets */
    @media (max-width: 768px) {
        #filters {
            gap: 1rem;
            justify-content: flex-start;
        }

        .tax-toggle {
            margin-left: 0;
        }
    }

    /* Mobile phones */
    @media (max-width: 480px) {
        #filters {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1rem 0.5rem;
        }

        .filter {
            min-width: 0;
            margin: 0;
        }

        .filter p {
            font-size: 0.7rem;
            white-space: normal;
        }

        .filter i {
            font-size: 1.2rem;
        }

        .tax-toggle {
            grid-column: 1 / -1;
            margin: 0;
            padding: 0.6rem;
        }

        .tax-toggle label {
            font-size: 0.85rem;
        }
       
    }
</style>

<div id="filters">
    <div class="filter">
        <div><i class="fa-duotone fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div>

    <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-tent"></i></div>
        <p>Camping</p>
    </div>

    <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input"
                   type="checkbox"
                   role="switch"
                   id="switchCheckDefault">

            <label class="form-check-label"
                   for="switchCheckDefault">
                Display total after taxes
            </label>
        </div>
    </div>
</div>







        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
              </form>
    <% for(let listing of allListing){%>
      <a  href="/listing/<%= listing._id %> " class="listing-link">
       <div class="card col listing-card" >
  <img src="<%= listing.image.url  %>" class="card-img-top" alt="listing_image" style="height:20rem">
  <div class="card-img-overlay">NM</div>
  <div class="card-body">
    <p class="card-text">
      <b>  <%= listing.title %></b> <br>
         &#8377;<%=listing.price.toLocaleString("en-IN")%>
         <i class="tax-info">&nbsp; &nbsp+18% GST</i>
    </p>
  </div>
</div>
</a>
   <% }%>
</body>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click",()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
        info.style.display = "inline";
      }else{
        info.style.display = "none";
      }
    }

  }) ;
</script>
