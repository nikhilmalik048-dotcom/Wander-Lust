
<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="show-page container py-4">

    <!-- Flash messages are handled by the main layout -->

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <!-- Listing Title -->
            <div class="show-header mb-4">
                <h1 class="show-title">
                    <%= listing.title %>
                </h1>
                <p class="show-subtitle">
                    Discover your next memorable stay
                </p>
            </div>

            <!-- Listing Card -->
            <div class="card show-card">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="<%= listing.title %>"
                >

                <div class="card-body show-card-body">

                    <p class="show-owner">
                        Hosted by
                        <strong>
                            <%= listing.owner
                                ? listing.owner.username
                                : "Unknown" %>
                        </strong>
                    </p>

                    <p class="show-description">
                        <%= listing.description %>
                    </p>

                    <div class="show-price">
                        ₹<%= listing.price.toLocaleString("en-IN") %>
                        <span> / night</span>
                    </div>

                    <div class="show-location">
                        <p>
                            <i class="fa-solid fa-location-dot"></i>
                            <%= listing.location %>
                        </p>
                        <p>
                            <i class="fa-solid fa-globe"></i>
                            <%= listing.country %>
                        </p>
                    </div>

                </div>
            </div>

            <!-- Edit and Delete Buttons: Listing Owner Only -->
            <% if (
                currentUser &&
                listing.owner &&
                currentUser._id.equals(listing.owner._id)
            ) { %>

                <div class="show-actions">

                    <a
                        href="/listing/<%= listing._id %>/edit"
                        class="btn show-edit-btn"
                    >
                        <i class="fa-solid fa-pen-to-square"></i>
                        Edit Listing
                    </a>

                    <form
                        method="POST"
                        action="/listing/<%= listing._id %>?_method=DELETE"
                        onsubmit="return confirm('Are you sure you want to delete this listing?');"
                    >
                        <button type="submit" class="btn show-delete-btn">
                            <i class="fa-solid fa-trash"></i>
                            Delete Listing
                        </button>
                    </form>

                </div>

            <% } %>

            <!-- Reviews Section -->
            <section class="show-reviews mt-5">

                <div class="section-heading">
                    <h2>Guest Reviews</h2>
                    <p>Share your experience with other travelers.</p>
                </div>

                <% if (currentUser) { %>

                    <div class="review-form-card">
                        <h3>Write a Review</h3>

                        <form
                            action="/listing/<%= listing._id %>/reviews"
                            method="POST"
                            novalidate
                            class="needs-validation"
                        >

                            <fieldset class="starability-slot">
                                <legend>Your rating</legend>

                                <input
                                    type="radio"
                                    id="no-rate"
                                    class="input-no-rate"
                                    name="review[rating]"
                                    value="1"
                                    checked
                                    aria-label="No rating"
                                />

                                <input type="radio" id="first-rate1"
                                    name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">
                                    1 star
                                </label>

                                <input type="radio" id="first-rate2"
                                    name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">
                                    2 stars
                                </label>

                                <input type="radio" id="first-rate3"
                                    name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">
                                    3 stars
                                </label>

                                <input type="radio" id="first-rate4"
                                    name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">
                                    4 stars
                                </label>

                                <input type="radio" id="first-rate5"
                                    name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">
                                    5 stars
                                </label>
                            </fieldset>

                            <div class="mb-3 mt-3">
                                <label for="comment" class="form-label">
                                    Your comment
                                </label>

                                <textarea
                                    id="comment"
                                    name="review[comment]"
                                    rows="4"
                                    class="form-control"
                                    placeholder="Tell us about your stay..."
                                    required
                                ></textarea>

                                <div class="invalid-feedback">
                                    Please enter a comment.
                                </div>
                            </div>

                            <button type="submit" class="btn review-submit-btn">
                                Submit Review
                            </button>

                        </form>
                    </div>

                <% } else { %>

                    <p class="review-login-note">
                        Please <a href="/login">log in</a> to write a review.
                    </p>

                <% } %>

                <!-- Existing Reviews -->
                <% if (listing.reviews && listing.reviews.length > 0) { %>

                    <div class="all-reviews mt-4">
                        <h3 class="mb-3">What guests are saying</h3>

                        <div class="row g-3">

                            <% for (let review of listing.reviews) { %>

                                <div class="col-12 col-md-6">

                                    <div class="card review-card h-100">
                                        <div class="card-body">

                                            <h4 class="review-author">
                                                <i class="fa-regular fa-circle-user"></i>
                                                <%= review.author
                                                    ? review.author.username
                                                    : "Anonymous" %>
                                            </h4>

                                            <p class="review-comment">
                                                <%= review.comment %>
                                            </p>

                                            <p
                                                class="starability-result review-stars"
                                                data-rating="<%= review.rating %>"
                                            ></p>

                                            <% if (
                                                currentUser &&
                                                review.author &&
                                                review.author._id.equals(currentUser._id)
                                            ) { %>

                                                <form
                                                    method="POST"
                                                    action="/listing/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                    onsubmit="return confirm('Delete this review?');"
                                                >
                                                    <button
                                                        type="submit"
                                                        class="btn btn-sm review-delete-btn"
                                                    >
                                                        <i class="fa-solid fa-trash"></i>
                                                        Delete Review
                                                    </button>
                                                </form>

                                            <% } %>

                                        </div>
                                    </div>

                                </div>

                            <% } %>

                        </div>
                    </div>

                <% } else { %>

                    <p class="no-reviews">
                        No reviews yet. Be the first to share your experience!
                    </p>

                <% } %>

            </section>

            <!-- Location Map -->
            <section class="show-map-section mt-5">
                <div class="section-heading">
                    <h2>Where you'll be</h2>
                    <p>Explore the location of this stay.</p>
                </div>

                <div id="map" aria-label="Listing location map"></div>
            </section>

        </div>
    </div>

</div>

<script src="/js/map.js"></script>
